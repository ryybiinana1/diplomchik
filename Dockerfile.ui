FROM python:3.11-slim

WORKDIR /app

# Лёгкий образ: без catboost/lightgbm/shap — обучение идёт в сервисе api
COPY requirements-ui.txt /app/requirements-ui.txt
RUN pip install --no-cache-dir -U pip \
    && pip install --no-cache-dir -r /app/requirements-ui.txt

COPY ui /app/ui

ENV PYTHONPATH=/app

EXPOSE 8501

CMD ["streamlit", "run", "ui/streamlit_app.py", "--server.address=0.0.0.0", "--server.port=8501"]
